---
import Shell from '../layouts/Shell.astro';
import { work, heroes, family, checks, sections } from '../data/ionych.js';

const heroCount = heroes.length;
const questionCount = Object.values(checks).reduce((n, list) => n + list.length, 0) + 1;

function plural(n, one, few, many) {
  const m10 = n % 10;
  const m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
  return many;
}

const subs = {
  dosye: `${heroCount + 1} ${plural(heroCount + 1, 'карточка', 'карточки', 'карточек')}`,
  check: `${questionCount} ${plural(questionCount, 'вопрос', 'вопроса', 'вопросов')}`,
  dyra: 'сопоставление',
};
---

<Shell title={work.title} screen="title">
  <main class="entry">
    <header class="arh-plate">
      <p class="arh-imprint">{work.author}</p>
      <h1 class="arh-title">{work.title}</h1>
      <p class="arh-year">MDCCCXCVIII</p>
      <ul class="arh-tags">
        {work.tags.map((t) => <li>{t}</li>)}
      </ul>
    </header>

    <nav class="arh-tabs" aria-label="Разделы произведения">
      {
        sections.map((s) => (
          <a class="arh-tab" href={s.href} data-petal-link>
            <span class="arh-tab-num">{s.num}</span>
            <span class="arh-tab-name">{s.name}</span>
            <span class="arh-tab-sub">{subs[s.id]}</span>
          </a>
        ))
      }
    </nav>

    <p class="arh-note">
      Путь по порядку: разобрать досье героя и тут же отработать его в сюжетном
      чеке, и так по всем. Когда закрыты все герои, открывается тест-дыра.
      Плашки при этом не заперты — если знаете материал, идите сразу к ней.
    </p>

    <section class="arh-cast" aria-labelledby="cast-h">
      <h2 class="arh-h" id="cast-h">Действующие лица</h2>
      <ul class="arh-slips">
        <li class="arh-slip arh-slip--family">
          <span class="arh-slip-name">{family.name}</span>
          <span class="arh-slip-role">{family.role}</span>
        </li>
        {
          heroes.map((h) => (
            <li class="arh-slip" data-short={h.id === 'sluga' ? 'true' : undefined}>
              <span class="arh-slip-name">{h.name}</span>
              <span class="arh-slip-role">{h.aka ? `«${h.aka}»` : h.role}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </main>

  <script>
    import { mountTitleScene, armSceneLinks } from '../scripts/petals.js';
    mountTitleScene({ count: window.innerWidth < 760 ? 18 : 28 });
    armSceneLinks();
  </script>
</Shell>

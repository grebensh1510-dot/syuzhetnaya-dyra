---
import Shell from '../layouts/Shell.astro';
import Header from '../components/Header.astro';
import CinematicPhoto from '../components/CinematicPhoto.astro';
import { work, heroes, family, checks } from '../data/ionych.js';

const heroCount = heroes.length + 1;
const questionCount = Object.values(checks).reduce((n, list) => n + list.length, 0) + 1;

function plural(n, one, few, many) {
  const m10 = n % 10;
  const m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
  return many;
}

// Эпиграф сверен по подлиннику: Старцев, глава IV.
const epigraph =
  'Старимся, полнеем, опускаемся. День да ночь — сутки прочь, жизнь проходит тускло, без впечатлений, без мыслей…';

const cast = [{ ...family, anchor: 'turkiny' }, ...heroes.map((h) => ({ ...h, anchor: h.id }))];
---

<Shell title={work.title} screen="title">
  <Header />

  <CinematicPhoto
    src="/hero/ionych-1680.jpg"
    srcNarrow="/hero/ionych-900.jpg"
    alt=""
    position="center 42%"
  >
    <div class="hero">
      <p class="hero__kicker">
        Знаешь сюжет.<br />Пора запомнить цитаты.
      </p>

      <h1 class="hero__title">{work.title}</h1>

      <div class="hero__act">
        <a class="hero__cta" href="/ionych/dosye/" data-petal-link>
          Начать тренировку
          <span class="hero__cta-arrow" aria-hidden="true">→</span>
        </a>
        <p class="hero__meta">
          {heroCount} {plural(heroCount, 'досье', 'досье', 'досье')} · {questionCount}{' '}
          {plural(questionCount, 'вопрос', 'вопроса', 'вопросов')} · без конспектов
        </p>
      </div>

      <figure class="hero__quote">
        <blockquote>{epigraph}</blockquote>
        <figcaption>
          <span class="hero__quote-who">{work.author}</span>
          <span class="hero__quote-src">«Ионыч», глава IV</span>
        </figcaption>
      </figure>
    </div>
  </CinematicPhoto>

  <section class="cast" aria-labelledby="cast-h">
    <h2 class="cast__h" id="cast-h">Действующие лица</h2>
    <ul class="cast__list">
      {
        cast.map((c) => (
          <li>
            <a class="cast__item" href={`/ionych/dosye/#${c.anchor}`}>
              <span class="cast__name">{c.name}</span>
              <span class="cast__role">{c.aka ? `«${c.aka}»` : c.role}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <script>
    import { mountTitleScene, armSceneLinks } from '../scripts/petals.js';
    mountTitleScene({ count: window.innerWidth < 760 ? 6 : 10 });
    armSceneLinks();
  </script>
</Shell>

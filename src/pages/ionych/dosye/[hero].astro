---
import Shell from '../../../layouts/Shell.astro';
import Header from '../../../components/Header.astro';
import { family, heroes, checks, plural } from '../../../data/ionych.js';

const cards = [
  { ...family, isFamily: true, photo: 'turkiny' },
  ...heroes.map((h) => ({ ...h, photo: h.id })),
];

export function getStaticPaths() {
  const list = [
    { ...family, isFamily: true, photo: 'turkiny' },
    ...heroes.map((h) => ({ ...h, photo: h.id })),
  ];
  return list.map((c, i) => ({
    params: { hero: c.photo },
    props: { index: i },
  }));
}

const { hero } = Astro.params;
const { index } = Astro.props;

const card = cards[index];
const roman = ['I', 'II', 'III', 'IV', 'V', 'VI'];
const prev = cards[(index - 1 + cards.length) % cards.length];
const next = cards[(index + 1) % cards.length];
---

<Shell title={`${card.name} · Досье`} screen="hero">
  <Header active="dosye" />

  <article class="cover">
    <div class="cover__photo">
      <img
        src={`/heroes/${card.photo}.jpg`}
        alt=""
        width="820"
        height="1230"
        fetchpriority="high"
        decoding="async"
        style={`view-transition-name: hero-${card.photo}`}
      />
    </div>

    <div class="cover__text">
      <span class="cover__badge" aria-hidden="true">{roman[index]}</span>
      <p class="cover__label">{card.group || card.role}</p>
      <h1 class="cover__name">{card.name}</h1>
      {card.aka && <p class="cover__aka">«{card.aka}»</p>}
    </div>

    <a class="cover__back" href="/ionych/dosye/">Вся колода</a>
  </article>

  <section class="sheetdoc">
    {/* Досье обходит снимок кругом: на широком экране портрет стоит в центре
        и держится при прокрутке, а строки идут по очереди то слева, то
        справа. На узком экране колонка одна, портрет спрятан — он только что
        был на обложке двумя экранами выше, второй раз подряд не нужен.
        Строки проявляются по одной при прокрутке; до того, как скрипт
        поднимется, они просто видны — без него страница не ломается. */}
    <div class="orbit" data-orbit>
      <div class="orbit__photo" aria-hidden="true">
        {/* Тот же файл, что на обложке: браузер берёт его из кэша. */}
        <img src={`/heroes/${card.photo}.jpg`} alt="" width="820" height="1230" decoding="async" />
      </div>

      <ol class="orbit__rows">
        {
          card.rows.map((r, i) => (
            <li
              class="orbit__row"
              data-orbit-row
              data-side={i % 2 ? 'right' : 'left'}
              style={`--i: ${i}`}
            >
              <p class="orbit__key">{r.key}</p>
              {r.quote && <blockquote class="ds-quote">{r.quote}</blockquote>}
              {r.quote && r.chapter && <p class="ds-ch">глава {r.chapter}</p>}
              {r.value && <p class="ds-value">{r.value}</p>}
            </li>
          ))
        }
      </ol>
    </div>

    {
      !card.isFamily && checks[card.id] ? (
        <a class="ds-go" href={`/ionych/check/?hero=${card.id}`}>
          Отработать в чеке
          <span class="ds-go__n">
            {checks[card.id].length}{' '}
            {plural(checks[card.id].length, 'вопрос', 'вопроса', 'вопросов')}
          </span>
        </a>
      ) : (
        <p class="ds-nocheck">
          У семьи нет своего блока в чеке — её факты разобраны внутри каждого
          из Туркиных.
        </p>
      )
    }

    <nav class="sheetdoc__nav" aria-label="Соседние герои">
      <a class="sheetdoc__step" href={`/ionych/dosye/${prev.photo}/`}>
        <span class="sheetdoc__dir">← предыдущий</span>
        <span class="sheetdoc__who">{prev.name}</span>
      </a>
      <a class="sheetdoc__step sheetdoc__step--next" href={`/ionych/dosye/${next.photo}/`}>
        <span class="sheetdoc__dir">следующий →</span>
        <span class="sheetdoc__who">{next.name}</span>
      </a>
    </nav>
  </section>

  <script>
    import { mountOrbit } from '../../../scripts/orbit.js';

    document.addEventListener('astro:page-load', () => {
      mountOrbit();
    });
  </script>
</Shell>

---
import Shell from '../../layouts/Shell.astro';
import Header from '../../components/Header.astro';
import { family, heroes, checks, plural } from '../../data/ionych.js';

// Семья идёт первой карточкой: она объясняет всех остальных.
const cards = [
  { ...family, isFamily: true, photo: 'turkiny' },
  ...heroes.map((h) => ({ ...h, photo: h.id })),
];
---

<Shell title="Досье героев · Ионыч" screen="dosye">
  <Header active="dosye" />

  <main class="dosye">
    <header class="ds-head">
      <h1 class="sp-h1">Досье героев</h1>
      <p class="sp-lead">
        Карточка на героя. Тяните колоду или жмите стрелки, чтобы выбрать;
        нажмите на карточку в центре — откроется её досье.
      </p>
    </header>

    <div class="deck" data-deck tabindex="0" role="group" aria-label="Колода героев">
      <div class="deck__stage">
        <div class="deck__surface" data-grabbing="false" aria-hidden="true"></div>
        {
          cards.map((c, i) => (
            <button
              class="deck__card"
              type="button"
              data-hero={c.photo}
              data-i={i}
              aria-label={`Открыть досье: ${c.name}`}
            >
              <img
                class="deck__img"
                src={`/heroes/${c.photo}.jpg`}
                alt=""
                width="820"
                height="1230"
                loading={i > 1 ? 'lazy' : 'eager'}
                decoding="async"
                draggable="false"
              />
              <span class="deck__plate">
                <span class="deck__name">{c.name}</span>
                <span class="deck__role">{c.aka ? `«${c.aka}»` : c.role}</span>
              </span>
            </button>
          ))
        }
      </div>

      <div class="deck__nav">
        <button class="deck__arrow" type="button" data-deck-prev aria-label="Предыдущий герой">
          ←
        </button>
        <span class="deck__counter" data-deck-counter aria-live="polite">1 / {cards.length}</span>
        <button class="deck__arrow" type="button" data-deck-next aria-label="Следующий герой">
          →
        </button>
      </div>

      <div class="deck__act">
        <button class="deck__open" type="button" data-deck-open>
          Открыть досье
          <span class="deck__open-arrow" aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </main>

  <!-- Досье вылетает из карточки поверх колоды -->
  <div class="dossier" data-dossier hidden>
    <button class="dossier__scrim" type="button" aria-label="Закрыть досье"></button>

    <div class="dossier__panel" role="dialog" aria-modal="true" aria-label="Досье героя">
      <button class="dossier__close" type="button">Закрыть</button>

      <div class="dossier__body">
        {
          cards.map((c, i) => (
            <article class="ds-card" data-panel-hero={c.photo} hidden={i > 0}>
              <header class="ds-card__head">
                <p class="ds-card__group">{c.group || c.role}</p>
                <h2 class="ds-card__name">
                  {c.name}
                  {c.aka && <span class="ds-card__aka">«{c.aka}»</span>}
                </h2>
              </header>

              <dl class="ds-rows">
                {c.rows.map((r) => (
                  <div class="ds-row">
                    <dt>{r.key}</dt>
                    <dd>
                      {r.quote && <blockquote class="ds-quote">{r.quote}</blockquote>}
                      {r.quote && r.chapter && <p class="ds-ch">глава {r.chapter}</p>}
                      {r.value && <p class="ds-value">{r.value}</p>}
                    </dd>
                  </div>
                ))}
              </dl>

              {
                !c.isFamily && checks[c.id] ? (
                  <a class="ds-go" href={`/ionych/check/?hero=${c.id}`}>
                    Отработать в чеке
                    <span class="ds-go__n">
                      {checks[c.id].length} {plural(checks[c.id].length, 'вопрос', 'вопроса', 'вопросов')}
                    </span>
                  </a>
                ) : (
                  <p class="ds-nocheck">
                    У семьи нет своего блока в чеке — её факты разобраны внутри
                    каждого из Туркиных.
                  </p>
                )
              }
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <script>
    import { mountDeck } from '../../scripts/deck.js';
    import { mountDossier } from '../../scripts/dossier.js';
    import { armSceneLinks, mountPetals } from '../../scripts/petals.js';
    import { readDone } from '../../scripts/progress.js';

    mountDossier();
    mountDeck();

    // Пройденные герои помечаются на карточках колоды.
    const done = new Set(readDone());
    document.querySelectorAll('.deck__card').forEach((card) => {
      if (done.has(card.dataset.hero)) card.dataset.done = 'true';
    });

    mountPetals();
    armSceneLinks();
  </script>
</Shell>

---
import Shell from '../../layouts/Shell.astro';
import Header from '../../components/Header.astro';
import NextWork from '../../components/NextWork.astro';
import { warmup, matching, taskFormat } from '../../data/ionych.js';

const task = matching[0];
---

<Shell title="Тест-дыра № 2 · Ионыч" screen="dyra">
  <Header active="dyra" />

  <main class="exam">
    <header class="ds-head">
      <h1 class="sp-h1">Тест-дыра № 2</h1>
      <p class="sp-lead" data-hint></p>
    </header>

    <section class="warm" aria-labelledby="h-warm">
      <header class="warm__head">
        <h2 class="sp-h2" id="h-warm">Разминка</h2>
        <button class="warm__skip" type="button">Пропустить</button>
      </header>
      <p class="sp-sub">
        Три коротких ответа с клавиатуры. Регистр и окончания не придираются.
      </p>

      <p class="warm__count" data-warm-count aria-live="polite">Отвечено 0 из {warmup.length}</p>

      <ol class="warm__list">
        {
          warmup.map((w) => (
            <li class="warm__row" data-answers={w.answers.join('|')}>
              <label class="warm__label" for={`w-${w.id}`}>
                {w.ask}
              </label>
              <input
                class="warm__input"
                id={`w-${w.id}`}
                type="text"
                autocomplete="off"
                spellcheck="false"
                enterkeyhint="next"
              />
              <span class="warm__verdict" aria-live="polite" />
              <p class="warm__why" hidden>{w.why}</p>
            </li>
          ))
        }
      </ol>
      <button class="warm__check" type="button">Проверить</button>
    </section>

    <section class="match" aria-labelledby="h-match" data-answer={JSON.stringify(task.answer)}>
      <h2 class="sp-h2" id="h-match">Сопоставление</h2>
      <p class="match__kind">{task.kind}</p>
      <p class="match__prompt">{task.prompt}</p>

      <div class="match__col" aria-label="Позиции">
        <p class="match__bank-h">Позиции</p>
        <ol class="match__left">
          {
            task.left.map((l) => (
              <li>
                <button class="slot" type="button" data-key={l.key} aria-expanded="false">
                  <span class="slot__key">{l.key}</span>
                  <span class="slot__label">{l.label}</span>
                  <span class="slot__pick" data-pick>выбрать</span>
                </button>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="match__bank" aria-label="Варианты">
        <p class="match__bank-h">Варианты</p>
        <ul class="match__options">
          {
            task.right.map((r) => (
              <li>
                <button class="bank" type="button" data-key={r.key}>
                  <span class="bank__key">{r.key}</span>
                  <span class="bank__label">{r.label}</span>
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Бланк, а не строка «Ответ: — — —»: клетки по числу позиций, над
          каждой её буква. Число клеток берётся из задания, не задано руками —
          формат ещё будет сверяться с демоверсией. */}
      <div class="blank">
        <p class="blank__lead">{taskFormat.answerLead}</p>
        <ol class="blank__cells">
          {
            task.left.map((l) => (
              <li class="blank__cell">
                <span class="blank__key">{l.key}</span>
                <span class="blank__digit" data-blank={l.key}>
                  —
                </span>
              </li>
            ))
          }
        </ol>
        <p class="blank__note">{taskFormat.answerNote}</p>
        <p class="blank__count" data-match-count aria-live="polite">
          Заполнено 0 из {task.left.length}
        </p>
      </div>

      <button class="match__check" type="button" disabled>Проверить</button>

      <div class="match__verdict" hidden>
        <p class="verdict__head"><span class="verdict__word" /></p>
        <ul class="match__rows" data-rows />
        <div class="match__extra">
          <p class="match__extra-lead">Лишний вариант</p>
          <p class="match__extra-text" data-extra-text />
          <p class="match__extra-why">{task.extraWhy}</p>
          {
            task.extraHero && (
              <a class="hero-link" href={`/ionych/dosye/${task.extraHero}/`}>
                <span class="hero-link__t">Посмотреть героя в досье</span>
                <span aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
        <button class="match__again" type="button">Пройти заново</button>

        {/* Момент наибольшей заинтересованности: человек только что дошёл
            до конца «Ионыча». Здесь и спрашиваем, что дальше. */}
        <NextWork heading="«Ионыч» пройден. Что разобрать следующим?" />
      </div>
    </section>
  </main>

  <script define:vars={{ taskData: task }} is:inline>
    window.__TASK__ = taskData;
  </script>

  <script>
    import { mountDyra } from '../../scripts/dyra.js';
    import { mountNextWork } from '../../scripts/next-work.js';
    
    document.addEventListener('astro:page-load', () => {
      mountDyra();
      mountNextWork();
    });
  </script>
</Shell>

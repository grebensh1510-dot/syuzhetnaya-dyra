---
// Вход «Архива»: титульная плашка внутри паспарту, состав — каталожные
// карточки в два столбца, разделы — вертикальный список с римскими цифрами.
const { work, heroes, quoteCount, tabs, variant } = Astro.props;
const roman = ['I', 'II', 'III'];
---

<main class="entry entry--arhiv">
  <header class="arh-plate">
    <p class="arh-imprint">{work.author}</p>
    <h1 class="arh-title">{work.title}</h1>
    <p class="arh-year">MDCCCXCVIII</p>
    <ul class="arh-tags">
      {work.tags.slice(0, 3).map((t) => <li>{t}</li>)}
    </ul>
  </header>

  <section class="arh-cast" aria-labelledby="cast-h">
    <h2 class="arh-h" id="cast-h">Действующие лица</h2>
    <ul class="arh-slips">
      {
        heroes.map((h) => (
          <li class="arh-slip" data-short={h.short ? 'true' : undefined}>
            <span class="arh-slip-name">{h.name}</span>
            <span class="arh-slip-role">{h.aka ? `«${h.aka}»` : h.role}</span>
          </li>
        ))
      }
    </ul>
    <p class="arh-count">{quoteCount} выверенных цитат в основе</p>
  </section>

  <nav class="arh-tabs" aria-label="Разделы произведения">
    {
      tabs.map((t, i) =>
        t.href ? (
          <a class="arh-tab" href={`/${variant}/${t.href}`} data-go="test">
            <span class="arh-tab-num">{roman[i]}</span>
            <span class="arh-tab-name">{t.name}</span>
            <span class="arh-tab-sub">{t.sub}</span>
          </a>
        ) : (
          <span class="arh-tab" aria-disabled="true">
            <span class="arh-tab-num">{roman[i]}</span>
            <span class="arh-tab-name">{t.name}</span>
            <span class="arh-tab-sub">ещё не собран</span>
          </span>
        )
      )
    }
  </nav>

  <p class="arh-note">
    Не читали рассказ? Начните со справки — она не запирает тест, но без неё
    ловушки работают против вас.
  </p>
</main>

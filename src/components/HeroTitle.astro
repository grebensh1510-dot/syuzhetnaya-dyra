---
/*
 * HeroTitle — заглавие рисует себя и заливается.
 *
 * Эффект тот же, что в присланном компоненте: буквы набраны в SVG и
 * прочерчиваются через stroke-dashoffset. Без React и без motion — это одна
 * анимация на входе, ей нечего делать в рантайме.
 *
 * Две вещи, которые пришлось добавить к приёму из компонента.
 *
 * 1. Длина штриха. dasharray у SVG-текста отсчитывается заново на КАЖДОМ
 *    контуре, поэтому нужна длина самого длинного, а не сумма. Компонент
 *    ищет её в браузере, растрируя SVG десяток раз и сравнивая «чернила» с
 *    готовой буквой; тот же поиск я прогнал один раз для «Ионыча» в Prata
 *    200 — 1023 единицы, это 1,49 ширины строки. Ставлю 1040 с запасом на
 *    подмену версии шрифта: лишние 2 % дают микропаузу в начале, а нехватка
 *    оставила бы буквы недорисованными.
 *
 * 2. Ход пера. Раз штрих идёт по всем контурам сразу, короткие буквы
 *    дорисовываются мгновенно и слово просто проступает целиком. Поверх
 *    наложена маска с размытым краем, которая едет слева направо: контур
 *    открывается по ходу письма, а не весь сразу.
 *
 * При другом заглавии замер повторяется тем же способом; промах не ломает
 * картинку, а лишь сбивает точность — ink по умолчанию считается из 1,49.
 */
const { text, ink } = Astro.props;

const glyphs = text.trim();
const dash = ink || Math.round(glyphs.length * 137 * 1.49);

// Свои id на экземпляр: маска и градиент не должны сталкиваться, если
// заглавие когда-нибудь окажется на странице дважды.
const uid = `ht-${Math.random().toString(36).slice(2, 9)}`;
---

<h1 class="ht" style={`--ht-dash: ${dash}`}>
  <svg
    class="ht__svg"
    viewBox="150 -10 700 195"
    aria-hidden="true"
    focusable="false"
    preserveAspectRatio="xMidYMid meet"
  >
    <defs>
      {/* Мягкий край пера: последние 14 % хода растворяются */}
      <linearGradient id={`${uid}-grad`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" />
        <stop offset="0.86" stop-color="#fff" />
        <stop offset="1" stop-color="#000" />
      </linearGradient>

      <mask id={`${uid}-mask`} maskUnits="userSpaceOnUse" x="0" y="-120" width="1100" height="440">
        <rect
          class="ht__wipe"
          x="-1000"
          y="-120"
          width="1060"
          height="440"
          fill={`url(#${uid}-grad)`}
        />
      </mask>
    </defs>

    {/* Контур прочерчивается под пером */}
    <g mask={`url(#${uid}-mask)`}>
      <text class="ht__text ht__text--draw" x="500" y="152">{glyphs}</text>
    </g>

    {/* Заливка проступает следом, когда перо дошло до конца */}
    <text class="ht__text ht__text--ink" x="500" y="152">{glyphs}</text>

    {/* Росчерк — тот же жест, что у пометки верного ответа */}
    <g class="ht__flourish">
      {/* Росчерк держится внутри viewBox по ширине слова: в прежних
          координатах он уезжал за кадр и перечёркивал кнопку. */}
      <path
        class="ht__stroke ht__stroke--a"
        d="M172 148C260 86 372 60 486 82S700 152 828 166"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
      <path
        class="ht__stroke ht__stroke--b"
        d="M248 172C400 184 590 182 742 168"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
      />
    </g>
  </svg>

  <span class="visually-hidden">{glyphs}</span>
</h1>

---
/*
 * HeroTitle — классическое начертание с блеском, проходящим по буквам.
 *
 * Приём из присланного animated-shiny-text: узкая светлая полоса едет по
 * тексту через background-position, обрезанная по глифам background-clip.
 *
 * Сделано ДВУМЯ слоями, а не одним, как в компоненте. В компоненте текст
 * прозрачный, а цвет и блеск даёт один градиент — значит контраст надписи
 * зависит от кадра анимации. Здесь нижний слой — обычный непрозрачный текст
 * в --wine-deep, он держит контраст всегда; блеск идёт отдельным слоем
 * поверх и только добавляет свет. Верхний слой помечен aria-hidden, чтобы
 * слово не читалось дважды.
 *
 * Слово теперь обычный HTML, а не SVG: background-clip: text по SVG-тексту
 * не работает, а размер и так задаётся clamp'ом.
 *
 * Росчерк остался SVG и по-прежнему прочерчивается — это тот же жест, что у
 * пометки верного ответа, и он же делает начертание «классическим», а не
 * просто крупным.
 */
const { text } = Astro.props;
const glyphs = String(text).trim();
---

<h1 class="ht">
  <span class="ht__word">
    <span class="ht__base">{glyphs}</span>
    <span class="ht__shine" aria-hidden="true">{glyphs}</span>

    <svg class="ht__flourish" viewBox="0 0 1000 150" aria-hidden="true" focusable="false">
      <path
        class="ht__stroke ht__stroke--a"
        d="M8 96C140 22 330 2 520 26S862 108 992 118"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
      <path
        class="ht__stroke ht__stroke--b"
        d="M96 132C300 146 640 144 900 128"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        vector-effect="non-scaling-stroke"
      />
    </svg>
  </span>
</h1>

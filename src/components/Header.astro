---
// Шапка сайта. Подпись о задании №2 отсюда убрана — она переехала на
// обрывок газеты справа в главном экране. Здесь остались знак, «Главная»
// и три раздела; активный помечен рукописным овалом (§5.4).
import Logo from './Logo.astro';
import { sections } from '../data/ionych.js';
const { active = '' } = Astro.props;
---

<header class="hdr">
  <a class="hdr__brand" href="/" data-petal-link aria-label="Сюжетная дыра — на главную">
    <Logo />
  </a>

  <nav class="hdr__nav" aria-label="Разделы произведения">
    <ul class="hdr__list">
      <li>
        <a
          class="hdr__link hdr__link--home"
          href="/"
          data-petal-link={active ? true : undefined}
          aria-current={active ? undefined : 'page'}
        >
          <span class="hdr__name">Главная</span>
          <span class="hdr__short">Главная</span>
        </a>
      </li>
      {
        sections.map((s) => (
          <li>
            <a
              class="hdr__link"
              href={s.href}
              data-petal-link={s.id === active ? undefined : true}
              aria-current={s.id === active ? 'page' : undefined}
            >
              <span class="hdr__num">{s.num}</span>
              <span class="hdr__name">{s.name}</span>
              <span class="hdr__short">{s.short}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

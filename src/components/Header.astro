---
// Шапка сайта. «Главная» показывается только на внутренних страницах —
// на самой главной она вела бы туда же, где стоишь.
//
// Активный раздел помечен рукописным овалом (§5.4). Овал не приклеен к
// пункту: он скользит за курсором и возвращается на активный, когда мышь
// уходит. Это та же механика, что у slide-tabs, но в языке системы.
import Logo from './Logo.astro';
import { sections } from '../data/ionych.js';
const { active = '' } = Astro.props;
const isHome = !active;
---

<header class="hdr">
  <a class="hdr__brand" href="/" data-petal-link aria-label="Сюжетная дыра — на главную">
    <Logo />
  </a>

  <nav class="hdr__nav" aria-label="Разделы произведения">
    <ul class="hdr__list" data-slide-nav>
      {
        !isHome && (
          <li>
            <a class="hdr__link hdr__link--home" href="/" data-petal-link data-slide-item>
              <span class="hdr__name">Главная</span>
              <span class="hdr__short">Главная</span>
            </a>
          </li>
        )
      }
      {
        sections.map((s) => (
          <li>
            <a
              class="hdr__link"
              href={s.href}
              data-slide-item
              data-current={s.id === active ? 'true' : undefined}
              data-petal-link={s.id === active ? undefined : true}
              aria-current={s.id === active ? 'page' : undefined}
            >
              <span class="hdr__num">{s.num}</span>
              <span class="hdr__name">{s.name}</span>
              <span class="hdr__short">{s.short}</span>
            </a>
          </li>
        ))
      }

      <li class="hdr__cursor" data-slide-cursor aria-hidden="true"></li>
    </ul>
  </nav>
</header>

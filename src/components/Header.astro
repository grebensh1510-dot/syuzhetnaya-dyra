---
// Шапка сайта.
//
// В левом углу: на главной — знак, на всех остальных страницах «Главная».
// Одно место, одна функция — и не нужен отдельный пункт в навигации.
//
// Заливки нет: шапка лежит на фотографии, и фон под ней не гасится.
// Активный раздел помечен рукописным овалом, который скользит за курсором
// и возвращается на активный (§5.4).
import Logo from './Logo.astro';
import { sections } from '../data/ionych.js';
import { to } from '../scripts/paths.js';
const { active = '' } = Astro.props;
const isHome = !active;
---

<header class="hdr">
  {
    isHome ? (
      <span class="hdr__brand hdr__brand--mark">
        <Logo />
      </span>
    ) : (
      <a class="hdr__brand hdr__brand--home" href={to('')}>
        <span class="hdr__home-arrow" aria-hidden="true">←</span>
        <span class="hdr__home-word">Главная</span>
      </a>
    )
  }

  <nav class="hdr__nav" aria-label="Разделы произведения">
    <ul class="hdr__list" data-slide-nav>
      {
        sections.map((s) => (
          <li>
            <a
              class="hdr__link"
              href={to(s.href)}
              data-slide-item
              data-current={s.id === active ? 'true' : undefined}
              aria-current={s.id === active ? 'page' : undefined}
            >
              <span class="hdr__num">{s.num}</span>
              <span class="hdr__name">{s.name}</span>
              <span class="hdr__short">{s.short}</span>
            </a>
          </li>
        ))
      }

      <li class="hdr__cursor" data-slide-cursor aria-hidden="true"></li>
    </ul>
  </nav>
</header>

---
/*
 * RollText — текст, который перекатывается в кадр кусок за куском.
 *
 * Приём из присланного компонента: каждый кусок поворачивается по оси X с
 * перспективой, как строка на механическом табло, со своей задержкой.
 *
 * by="word" (по умолчанию) — по словам. by="char" — по буквам.
 *
 * Почему цитаты — по СЛОВАМ, а не по буквам, как в компоненте: цитата из
 * Чехова — это сто с лишним знаков. Сто отдельно кувыркающихся букв читать
 * невозможно, а элементов в разметке становится под тысячу на страницу.
 * По буквам разбираются только короткие подписи вроде «В ФИНАЛЕ» — там этот
 * эффект и работает. Смысл при этом не меняется: катится тот же текст.
 *
 * Разбивка делается на сборке, а не в браузере: разметка приходит готовой,
 * скрипту остаётся только сказать «эта строка вошла в экран».
 *
 * Пробелы оставлены ТЕКСТОМ между кусками, а не внутри них: у inline-block
 * пробел внутри съедается, и слова слипаются.
 */
const { text, by = 'word' } = Astro.props;

const src = String(text);

// Сначала всегда по словам, и только внутри слова — по буквам. Иначе буквы
// становятся отдельными inline-block, и браузер переносит строку посреди
// слова: «ПОЧЕМУ НЕ ПЕЧАТ / АЕТ». Слово остаётся неразрывным куском.
const tokens = src.split(/(\s+)/).filter((p) => p !== '');

// Такт считается по видимым кускам: пробелы его не съедают, иначе перекат
// шёл бы рывками.
let n = -1;
const items = tokens.map((token) => {
  if (/^\s+$/.test(token)) return { blank: true, token };
  const chars = by === 'char' ? [...token] : [token];
  const withIndex = chars.map((ch) => {
    n += 1;
    return { ch, i: n };
  });
  return { blank: false, chars: withIndex };
});
---

{
  items.map((item) =>
    item.blank ? (
      <Fragment set:text={item.token} />
    ) : (
      <span class="roll-word">
        {item.chars.map(({ ch, i }) => (
          <span class="roll" style={`--r: ${i}`}>{ch}</span>
        ))}
      </span>
    )
  )
}

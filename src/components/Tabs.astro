---
// Три равные плашки, всегда доступны. Порядок — рекомендованный путь,
// но замок на них не вешается: уверенный ученик идёт сразу к тесту.
import { sections } from '../data/ionych.js';
const { active } = Astro.props;
---

<nav class="tabs" aria-label="Разделы произведения">
  <a class="tabs__home" href="/" data-petal-link aria-label="К выбору произведения">Ионыч</a>
  <ul class="tabs__list">
    {
      sections.map((s) => (
        <li>
          <a
            class="tabs__tab"
            href={s.href}
            data-petal-link={s.id === active ? undefined : true}
            aria-current={s.id === active ? 'page' : undefined}
          >
            <span class="tabs__num">{s.num}</span>
            <span class="tabs__name">{s.name}</span>
            <span class="tabs__short">{s.short}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

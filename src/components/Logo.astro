---
// Знак: прожжённая дыра в странице, на краю которой стоит фигура.
// Дыра нарисована одним контуром с рваным краем, фигура — силуэт из §3.2
// дизайн-системы. Красный росчерк под словом — тот же жест, что и пометка.
---

<span class="logo">
  <svg class="logo__mark" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
    <!-- Обугленный край: неровное пятно вокруг пустоты -->
    <path
      class="logo__burn"
      d="M30 3c7-1 13 2 17 7 5 5 9 9 11 15 2 7 1 14-3 20-4 7-11 12-19 14-8 2-17 0-22-6C9 47 5 40 6 32c1-8 4-16 10-22C20 6 25 4 30 3Z"
    />
    <!-- Сама дыра -->
    <path
      class="logo__void"
      d="M31 11c6-1 12 2 15 7 4 6 6 13 4 20-2 8-8 14-16 15-7 1-14-3-17-10-3-6-3-14 0-20 3-7 8-11 14-12Z"
    />
    <!-- Фигура на краю -->
    <g class="logo__figure">
      <circle cx="43" cy="27" r="4.4" />
      <path d="M43 32.5c4.6 0 7.3 3.4 7.9 8 .7 5.8.3 11.1-.8 16.3h-4.2l-1-12.3-1 12.3h-4.2c-1.1-5.2-1.5-10.5-.8-16.3.6-4.6 3.3-8 7.9-8Z" />
    </g>
  </svg>

  <span class="logo__word">
    <span class="logo__name">Сюжетная<br />дыра</span>
    <svg class="logo__flourish" viewBox="0 0 150 16" aria-hidden="true" focusable="false">
      <path
        d="M3 11C22 5 52 2 86 4c22 1.3 42 4 61 8"
        fill="none"
        stroke="currentColor"
        stroke-width="2.2"
        stroke-linecap="round"
      />
    </svg>
  </span>
</span>
